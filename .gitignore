# Environments — s'applique à backend/.env et frontend/.env(.local) aussi
.env
.env.local
.venv/
venv/
env/
node_modules/
dist/

# Python cache
__pycache__/
*.py[cod]

# IDEs
.vscode/
.idea/
.history/

# Streamlit (app historique)
.streamlit/

# Logs & artefacts
logs/
*.log
mlflow_artifacts/
models_output/

# Bases de données locales (SQLite dev)
backend/database/*.db

# Datasets uploadés par les utilisateurs (Lot 2) — jamais dans git
backend/storage/datasets/*
!backend/storage/datasets/.gitkeep

# Modèles entraînés (artefacts joblib, Lot 3) — jamais dans git
backend/storage/models/*
!backend/storage/models/.gitkeep

# CatBoost écrit ses logs d'entraînement dans le répertoire courant (Lot 3)
catboost_info/

# Données utilisateur (jeux de données legacy app Streamlit — chemins précis,
# ne masque plus *.csv/*.json/*.xlsx globalement pour ne pas ignorer par
# erreur des fichiers de config comme package.json/tsconfig.json)
notebooks/*.csv
notebooks/*.parquet

# Dépendances Python
.eggs/
*.egg-info/

# Testing
.pytest_cache/
.coverage

# Jupyter Notebooks
.ipynb_checkpoints/

# mvtec_ad (dataset volumineux, non versionné)
mvtec/
src/data/mvtec_ad/


