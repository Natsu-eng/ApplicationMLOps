# ═══════════════════════════════════════════════════════════════════════════
# NGINX — DataLab Pro
# Rôle : sert les fichiers statiques React + proxy /api vers le backend FastAPI
#
# TEMPLATE envsubst (image nginx officielle : tout fichier sous
# /etc/nginx/templates/*.template est passé à envsubst puis écrit dans
# /etc/nginx/conf.d au démarrage du conteneur, voir Dockerfile.frontend).
# Seules les variables listées ci-dessous sont substituées (l'entrypoint
# nginx limite envsubst aux noms de variables réellement présents dans
# l'environnement du conteneur) — les variables nginx natives ($host,
# $remote_addr, $scheme, etc. ci-dessous) ne sont JAMAIS des variables
# d'environnement du conteneur, donc jamais touchées par envsubst.
# ═══════════════════════════════════════════════════════════════════════════

upstream backend_api {
    server backend:8000;
    keepalive 32;
}

limit_req_zone $binary_remote_addr zone=api_limit:10m rate=30r/s;

server {
    listen 80;
    server_name _;

    # Correctif (retour utilisateur) — 20M en dur rejetait tout import
    # réel en 413 : max_upload_size_mb (tabulaire) = 200,
    # max_vision_upload_size_mb (images) = 500 côté backend
    # (api/core/config.py). nginx ne doit JAMAIS être plus strict que
    # l'application — sinon la requête est rejetée avant même d'atteindre
    # le code applicatif, qui a pourtant sa propre limite (mieux formulée,
    # en français). Aligné sur MAX_VISION_UPLOAD_SIZE_MB (le plus grand des
    # deux) et lu depuis LA MÊME variable d'environnement que le backend
    # (backend/.env) — une seule source, jamais deux nombres qui peuvent
    # diverger silencieusement.
    client_max_body_size ${MAX_VISION_UPLOAD_SIZE_MB}M;

    # ── Fichiers statiques React (SPA) ────────────────────────────────────
    location / {
        root  /usr/share/nginx/html;
        index index.html;
        try_files $uri $uri/ /index.html;

        location ~* \.(js|css|woff2?|ttf|svg|png|ico)$ {
            expires 1y;
            add_header Cache-Control "public, immutable";
        }
    }

    # ── Backend FastAPI ────────────────────────────────────────────────────
    location /api/ {
        limit_req zone=api_limit burst=20 nodelay;

        proxy_pass          http://backend_api;
        proxy_http_version  1.1;
        proxy_set_header    Host              $host;
        proxy_set_header    X-Real-IP         $remote_addr;
        proxy_set_header    X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header    X-Forwarded-Proto $scheme;
        proxy_read_timeout  120s;
        proxy_connect_timeout 10s;
    }

    location /nginx-health {
        access_log  off;
        return      200 "healthy\n";
        add_header  Content-Type text/plain;
    }
}
