# DataLab Pro — Backend : variables d'environnement
# Copier ce fichier en .env et ajuster si besoin (les défauts suffisent en dev local)

# ── Application ──────────────────────────────────────────────────────────────
ENVIRONMENT=development
APP_NAME=DataLab Pro
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# ── Frontend (autorisation CORS) ──────────────────────────────────────────────
# Dev : http://localhost:5173 | Prod : URL publique du frontend déployé
FRONTEND_URL=http://localhost:5173

# ── Base de données ────────────────────────────────────────────────────────────
# SQLite par défaut en dev (aucune valeur requise, le fichier est créé automatiquement).
# En production ou via Docker Compose : postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=sqlite:///./database/datalab.db

# ── PostgreSQL (consommé par docker-compose.yml uniquement) ───────────────────
POSTGRES_USER=datalab
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=datalab

# ── Authentification (JWT HS256) ──────────────────────────────────────────────
# ⚠️ OBLIGATOIRE — ne jamais laisser la valeur par défaut en production.
# Générer : python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET_KEY=changez-cette-cle-en-production

# ── À venir (lots suivants — pas encore lus par le code) ─────────────────────
# REDIS_URL               (Lot 3 — file de tâches RQ pour l'entraînement)
# MLFLOW_TRACKING_URI     (repris de l'app Streamlit historique lors du portage)
