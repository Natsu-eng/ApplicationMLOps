# DataLab Pro — Backend : variables d'environnement
# Copier ce fichier en .env et ajuster si besoin (les défauts suffisent en dev local)

# ── Application ──────────────────────────────────────────────────────────────
ENVIRONMENT=development
APP_NAME=DataLab Pro
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# ── Frontend (autorisation CORS) ──────────────────────────────────────────────
# Dev : http://localhost:5173 | Prod : URL publique du frontend déployé
FRONTEND_URL=http://localhost:5173

# ── Base de données ────────────────────────────────────────────────────────────
# SQLite par défaut en dev (aucune valeur requise, le fichier est créé automatiquement).
# En production ou via Docker Compose : postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=sqlite:///./database/datalab.db

# ── PostgreSQL (consommé par docker-compose.yml uniquement) ───────────────────
POSTGRES_USER=datalab
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=datalab

# ── Authentification (JWT HS256) ──────────────────────────────────────────────
# ⚠️ OBLIGATOIRE — ne jamais laisser la valeur par défaut en production.
# Générer : python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET_KEY=changez-cette-cle-en-production

# ── File de tâches d'entraînement (RQ + Redis) ────────────────────────────────
# Dev local (Redis installé/lancé à la main ou via Docker) : redis://localhost:6379/0
# Docker Compose : redis://redis:6379/0 (surchargé automatiquement dans docker-compose.yml)
REDIS_URL=redis://localhost:6379/0

# ── Entraînement ML — défauts (ajustables par job, voir POST /training/jobs) ─
OPTUNA_TRIALS_DEFAULT=20
CV_FOLDS_DEFAULT=4
SHAP_SAMPLE_SIZE=500
CQR_ALPHA=0.20
CQR_N_STRATA=5
MODEL_SEED=42

# ── Worker RQ (Lot 1.3, correctif C7) ─────────────────────────────────────────
# "fork" (Worker classique, isolation par job) ou "simple" (SimpleWorker,
# SEUL mode fonctionnel sous Windows — os.fork() n'y existe pas). Non défini :
# détecté automatiquement depuis la plateforme. docker-compose.yml fixe
# explicitement "fork" pour le service worker (jamais "simple" en production).
# RQ_WORKER_MODE=fork

# ── À venir (lots suivants — pas encore lus par le code) ─────────────────────
# MLFLOW_TRACKING_URI     (repris de l'app Streamlit historique lors du portage)
