# DataLab Pro — Backend : variables d'environnement
# Copier ce fichier en .env et ajuster si besoin (les défauts suffisent en dev local)

# ── Application ──────────────────────────────────────────────────────────────
ENVIRONMENT=development
APP_NAME=DataLab Pro
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# ── Frontend (autorisation CORS) ──────────────────────────────────────────────
# Dev : http://localhost:5173 | Prod : URL publique du frontend déployé
FRONTEND_URL=http://localhost:5173

# ── Base de données ────────────────────────────────────────────────────────────
# SQLite par défaut en dev (aucune valeur requise, le fichier est créé automatiquement).
# En production ou via Docker Compose : postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=sqlite:///./database/datalab.db

# ── PostgreSQL (consommé par docker-compose.yml uniquement) ───────────────────
POSTGRES_USER=datalab
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=datalab

# ── Authentification (JWT HS256) ──────────────────────────────────────────────
# ⚠️ OBLIGATOIRE — ne jamais laisser la valeur par défaut en production.
# Générer : python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET_KEY=changez-cette-cle-en-production

# ── File de tâches d'entraînement (RQ + Redis) ────────────────────────────────
# Dev local (Redis installé/lancé à la main ou via Docker) : redis://localhost:6379/0
# Docker Compose : redis://redis:6379/0 (surchargé automatiquement dans docker-compose.yml)
REDIS_URL=redis://localhost:6379/0

# ── Limites d'upload (Mo) ──────────────────────────────────────────────────────
# Source UNIQUE (correctif — retour utilisateur) : nginx (nginx/templates/
# default.conf.template, client_max_body_size) lit MAX_VISION_UPLOAD_SIZE_MB
# depuis CE fichier via docker-compose.yml — ne jamais fixer une limite nginx
# différente en dur, elle divergerait silencieusement de celle-ci.
MAX_UPLOAD_SIZE_MB=200
MAX_VISION_UPLOAD_SIZE_MB=500

# ── Entraînement ML — défauts (ajustables par job, voir POST /training/jobs) ─
OPTUNA_TRIALS_DEFAULT=20
CV_FOLDS_DEFAULT=4
SHAP_SAMPLE_SIZE=500
CQR_ALPHA=0.20
CQR_N_STRATA=5
MODEL_SEED=42

# ── Worker RQ (Lot 1.3, correctif C7) ─────────────────────────────────────────
# "fork" (Worker classique, isolation par job) ou "simple" (SimpleWorker,
# SEUL mode fonctionnel sous Windows — os.fork() n'y existe pas). Non défini :
# détecté automatiquement depuis la plateforme. docker-compose.yml fixe
# explicitement "fork" pour le service worker (jamais "simple" en production).
# RQ_WORKER_MODE=fork

# Files écoutées par CE process (Lot 4, correctif I6) — liste séparée par des
# virgules parmi "training", "vision", "analysis" (voir api/core/job_queue.py).
# Non définie : les 3 sont écoutées (pratique pour un unique worker de dev).
# docker-compose.yml fixe une valeur différente par service (worker, worker-analysis).
# RQ_QUEUES=training,vision,analysis

# ── Observabilité (Lot 4, correctif I7) ───────────────────────────────────────
# Sentry — laisser vide/absent désactive complètement Sentry (aucun rapport
# d'erreur envoyé, comportement inchangé). Renseigner uniquement en production.
# SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx
# Métriques Prometheus exposées sur GET /metrics (pas de variable à définir).

# ── Durcissement SaaS (Phase 1, AUDIT_BACKEND_2026-08-23.md) ─────────────────
# IP cliente réelle derrière nginx (api/core/rate_limit.py::get_client_ip) —
# CIDR séparés par des virgules, JAMAIS "*". Défaut = plage standard des
# réseaux bridge Docker (couvre datalab_network) ; à resserrer si le
# déploiement change de topologie réseau.
TRUSTED_PROXY_CIDRS=172.16.0.0/12

# Quota d'entraînements concurrents par organisation (garde-fou technique,
# pas un plan tarifaire).
MAX_CONCURRENT_JOBS_PER_ORG=3
# Délai (minutes) sans signal de vie au-delà duquel un job "running" est
# considéré orphelin (worker mort) — voir domains/shared/job_watchdog.py.
STALE_JOB_TIMEOUT_MINUTES=40

# Limitation de débit par IP cliente — fenêtre glissante Redis. "login" est
# volontairement plus stricte (force brute sur mot de passe) ; "register"/
# "upload"/"explain" protègent respectivement le spam de comptes et les
# endpoints coûteux (extraction ZIP, chargement d'un modèle torch).
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
REGISTER_RATE_LIMIT_MAX_ATTEMPTS=10
REGISTER_RATE_LIMIT_WINDOW_SECONDS=3600
UPLOAD_RATE_LIMIT_MAX_ATTEMPTS=30
UPLOAD_RATE_LIMIT_WINDOW_SECONDS=3600
EXPLAIN_RATE_LIMIT_MAX_ATTEMPTS=20
EXPLAIN_RATE_LIMIT_WINDOW_SECONDS=3600

# Taille max (Mo) d'un corps JSON (hors upload multipart, qui a ses propres
# limites dédiées) et nombre max d'images acceptées dans un dataset vision.
MAX_JSON_BODY_SIZE_MB=2
MAX_VISION_DATASET_IMAGES=5000

# Rétention des prédictions individuelles (jours) — purgées à la demande,
# voir domains/training/services/prediction_retention.py.
PREDICTION_RETENTION_DAYS=90

# ── Réinitialisation de mot de passe (Phase 1B, AUDIT_BACKEND_2026-08-23.md) ─
# Mêmes noms de variable que CIAM (E:\concrete-ai-platform) — le même bloc
# .env fonctionne des deux côtés sans réécriture. Canal OPTIONNEL au
# démarrage : sans lui, l'API démarre normalement et
# POST /auth/password-reset/request répond toujours 204 (en journalisant que
# le canal est absent). En PRODUCTION en revanche, l'absence de ce bloc
# déclenche un avertissement explicite au démarrage — un reset qui répond
# 204 sans jamais envoyer de mail est le pire des deux mondes.
#
# SMTP_PASSWORD : un MOT DE PASSE D'APPLICATION Gmail (compte Google →
# Sécurité → Mots de passe des applications), JAMAIS le mot de passe du
# compte Google lui-même — celui-ci n'aurait de toute façon pas fonctionné
# si la validation en 2 étapes est active, et le stocker en clair dans ce
# fichier serait un risque bien plus grave qu'un mot de passe d'application
# révocable indépendamment.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME@gmail.com
SMTP_PASSWORD=CHANGE_ME_mot_de_passe_application

# Durée de validité (minutes) d'un lien de réinitialisation envoyé par e-mail.
PASSWORD_RESET_EXPIRE_MINUTES=30
# Durcissement au-delà de CIAM : limite AUSSI par compte (adresse e-mail),
# pas seulement par IP — un attaquant qui change d'IP inonderait sinon la
# boîte mail de la victime.
PASSWORD_RESET_RATE_LIMIT_MAX_ATTEMPTS_PER_IP=5
PASSWORD_RESET_RATE_LIMIT_MAX_ATTEMPTS_PER_EMAIL=3
PASSWORD_RESET_RATE_LIMIT_WINDOW_SECONDS=3600

# ── À venir (lots suivants — pas encore lus par le code) ─────────────────────
# MLFLOW_TRACKING_URI     (repris de l'app Streamlit historique lors du portage)
